---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import NavTabs from '../components/NavTabs.astro';
import RamenBuilder from '../components/RamenBuilder.astro';
import MenuSection from '../components/MenuSection.astro';
import OrderSidebar from '../components/OrderSidebar.astro';
import MobileCartBar from '../components/MobileCartBar.astro';
import OrderModal from '../components/OrderModal.astro';
import Toast from '../components/Toast.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { steps, complementos, pastas, bebidas, postres, RAMEN_PRICE } from '../scripts/menu.js';
---

<Layout title="Casablanca Ramen House — Pedidos">
  <div class="pb-[70px] md:pb-0">
    <SiteHeader />
    <Hero />
   <NavTabs />

    <div class="flex gap-0 max-w-[1200px] mx-auto">
      <main class="flex-1 min-w-0 px-6 py-8">
        <RamenBuilder steps={steps} />
        <MenuSection id="complementos" tag="02" title="Complementos" cat="complementos" items={complementos} />
        <MenuSection id="pastas" tag="03" title="Pastas" cat="pastas" items={pastas} />
        <MenuSection id="bebidas" tag="04" title="Bebidas" cat="bebidas" items={bebidas} />
        <MenuSection id="postres" tag="05" title="Postres" cat="postres" items={postres} />
      </main>

      <OrderSidebar />
    </div>

    <MobileCartBar />
    <OrderModal />
    <Toast />
    <SiteFooter />
  </div>

  <script define:vars={{ RAMEN_PRICE }} is:inline>
    window.__RAMEN_PRICE__ = RAMEN_PRICE;
  </script>
  <script>
    import { initApp } from '../scripts/main.js';
    initApp(window.__RAMEN_PRICE__);
  </script>
</Layout>