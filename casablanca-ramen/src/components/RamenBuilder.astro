---
interface Option {
  id: string;
  name: string;
  extra?: number;
}
interface Step {
  id: number;
  key: string;
  label: string;
  subtitle: string;
  required?: boolean;
  max?: number;
  options: Option[];
}
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
---
<section class="mb-16 scroll-mt-[130px] relative" id="sec-ramen">
  <div class="relative flex items-center gap-4 mb-8 pb-3 border-b border-white/5 before:content-[''] before:absolute before:-bottom-px before:left-0 before:w-16 before:h-[2px] before:bg-red before:shadow-[0_0_10px_rgba(204,26,26,0.5)]">
    <span class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-red bg-red/10 border border-red/30 px-3 py-1 rounded-md flex-shrink-0 shadow-[0_0_10px_rgba(204,26,26,0.1)]">01</span>
    <h2 class="font-display text-[1.2rem] text-bone tracking-[0.08em]">Arma tu Ramen</h2>
    <div class="flex-1 h-px bg-gradient-to-r from-border-dim to-transparent"></div>
  </div>

  <div class="sticky top-[130px] z-20 mb-10 p-5 bg-card/80 backdrop-blur-md border border-white/5 rounded-xl shadow-[0_4px_20px_rgba(0,0,0,0.2)]">
    <div class="flex justify-between items-end mb-2">
      <span class="text-[0.75rem] font-medium text-muted uppercase tracking-[0.1em]" id="progress-text">0 de 4 pasos requeridos</span>
      <span class="text-red font-display text-xl leading-none drop-shadow-[0_0_8px_rgba(204,26,26,0.4)]" id="progress-pct">0%</span>
    </div>
    <div class="h-1.5 bg-surface rounded-full overflow-hidden border border-white/5">
      <div
        class="h-full rounded-full transition-all duration-500 ease-out shadow-[0_0_10px_rgba(204,26,26,0.8)] bg-gradient-to-r from-[#8b0000] to-[#ff3333] relative"
        id="progress-fill"
        style="width:0%"
      >
        <div class="absolute inset-0 bg-white/20 animate-pulse"></div>
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    {
      steps.map((step) => (
        <div
          class="group relative grid gap-x-6 pb-10 [grid-template-columns:50px_1fr] last:before:hidden before:content-[''] before:absolute before:left-[24px] before:top-14 before:bottom-0 before:w-0.5 before:bg-gradient-to-b before:from-red/30 before:to-transparent"
          id={`step-${step.id}`}
        >
          <div class="flex flex-col items-center pt-1">
            <div class="w-12 h-12 rounded-full bg-card border-2 border-border-dim text-muted text-lg font-bold font-display flex items-center justify-center flex-shrink-0 relative z-[1] transition-all duration-300 group-data-[state=done]:bg-gradient-to-br group-data-[state=done]:from-[#cc1a1a] group-data-[state=done]:to-[#8b0000] group-data-[state=done]:border-red group-data-[state=done]:text-white group-data-[state=done]:shadow-[0_0_20px_rgba(204,26,26,0.5)] group-data-[state=active]:bg-card group-data-[state=active]:border-red group-data-[state=active]:text-red group-data-[state=active]:shadow-[0_0_15px_rgba(204,26,26,0.3)] group-data-[state=active]:scale-110">
              {step.id}
            </div>
          </div>
          <div class="min-w-0 bg-surface/30 rounded-xl p-4 border border-transparent transition-colors duration-300 group-data-[state=active]:border-white/5 group-data-[state=active]:bg-card/40">
            <div class="flex items-baseline gap-[0.6rem] mb-4">
              <span class="font-display text-[1.1rem] font-bold text-muted tracking-[0.06em] transition-colors duration-300 group-data-[state=active]:text-bone group-data-[state=done]:text-bone">
                {step.label}
              </span>
              <span class="text-[0.7rem] text-muted/80 tracking-[0.08em] uppercase">{step.subtitle}</span>
              {step.required && <span class="text-[0.9rem] text-red leading-none animate-pulse">*</span>}
            </div>
            <div class="flex flex-wrap gap-3">
              {step.options.map((opt) => (
                <button
                  class="px-5 py-2.5 rounded-lg border border-white/5 bg-card/80 text-muted text-[0.85rem] font-medium cursor-pointer transition-all duration-200 flex items-center gap-2 tracking-[0.03em] relative overflow-hidden hover:border-red/50 hover:text-bone hover:-translate-y-1 hover:shadow-[0_5px_15px_rgba(0,0,0,0.4)] active:scale-95 data-[selected]:border-red data-[selected]:bg-red/10 data-[selected]:text-white data-[selected]:shadow-[0_0_15px_rgba(204,26,26,0.25)] before:content-[''] before:absolute before:inset-0 before:opacity-0 before:transition-opacity before:duration-200 before:bg-gradient-to-br before:from-red/10 before:to-transparent hover:before:opacity-100 data-[selected]:before:opacity-100"
                  data-step={step.key}
                  data-id={opt.id}
                  data-name={opt.name}
                  data-extra={opt.extra || 0}
                  data-max={step.max || 1}
                >
                  {opt.name}
                  {opt.extra! > 0 && (
                    <span class="text-[0.7rem] px-2 py-0.5 rounded-md bg-red/20 text-red border border-red/30 font-bold ml-1">+${opt.extra}</span>
                  )}
                </button>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-8 relative group">
    <div class="absolute inset-0 bg-red rounded-xl blur-lg opacity-0 group-hover:opacity-40 transition-opacity duration-500 peer-disabled:hidden"></div>
    <button
      class="relative w-full py-4 rounded-xl text-white border-0 font-display text-[0.9rem] font-bold uppercase tracking-[0.15em] transition-all duration-300 shadow-[0_5px_20px_rgba(204,26,26,0.3)] bg-gradient-to-r from-[#8b0000] to-[#cc1a1a] enabled:hover:-translate-y-1 enabled:hover:shadow-[0_8px_30px_rgba(204,26,26,0.5)] enabled:active:scale-[0.98] disabled:bg-card disabled:bg-none disabled:text-muted/50 disabled:border disabled:border-white/5 disabled:shadow-none disabled:cursor-not-allowed peer"
      id="add-ramen-btn"
      disabled
    >
      Agregar Ramen al pedido
    </button>
  </div>
</section>