---
interface Item {
  id: string;
  name: string;
  price: number;
  note?: string;
}
interface Props {
  id: string;
  tag: string;
  title: string;
  cat: string;
  items: Item[];
}
const { id, tag, title, cat, items } = Astro.props;
---
<section class="mb-16 scroll-mt-[130px]" id={`sec-${id}`}>
  <div class="relative flex items-center gap-4 mb-8 pb-3 border-b border-white/5 before:content-[''] before:absolute before:-bottom-px before:left-0 before:w-16 before:h-[2px] before:bg-red before:shadow-[0_0_10px_rgba(204,26,26,0.5)]">
    <span class="text-[0.65rem] font-bold tracking-[0.25em] uppercase text-red bg-red/10 border border-red/30 px-3 py-1 rounded-md flex-shrink-0 shadow-[0_0_10px_rgba(204,26,26,0.1)]">{tag}</span>
    <h2 class="font-display text-[1.2rem] text-bone tracking-[0.08em]">{title}</h2>
    <div class="flex-1 h-px bg-gradient-to-r from-border-dim to-transparent"></div>
  </div>

  <div class="grid gap-4 [grid-template-columns:repeat(auto-fill,minmax(170px,1fr))]">
    {
      items.map((item) => (
        <div class="group bg-card/60 backdrop-blur-sm border border-border-dim rounded-xl p-4 flex flex-col gap-1 transition-all duration-300 hover:-translate-y-1 hover:border-red/50 hover:bg-card-hover hover:shadow-[0_8px_25px_rgba(204,26,26,0.15)] relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-red/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-0" />
          <div class="absolute -inset-2 bg-gradient-to-br from-red/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-0" />

          <span class="relative z-10 text-[0.9rem] font-semibold text-bone leading-[1.3] transition-colors group-hover:text-white">{item.name}</span>
          {item.note && <span class="relative z-10 text-[0.7rem] text-muted/80 leading-snug">{item.note}</span>}

          <span class="relative z-10 font-display text-[1rem] text-red mt-auto pt-2 drop-shadow-[0_0_5px_rgba(204,26,26,0.2)]">${item.price}</span>

          <div class="relative z-10 flex items-center justify-between mt-3 pt-3 border-t border-white/5">
            <span class="text-[0.7rem] text-muted uppercase tracking-wider font-medium">Cant.</span>
            <div class="flex items-center gap-1 bg-surface/50 rounded-full p-1 border border-border-dim/50">
              <button
                class="w-7 h-7 rounded-full bg-card border border-border-dim text-bone text-sm flex items-center justify-center transition-all duration-200 hover:border-red hover:text-red hover:bg-red/10 active:scale-90"
                data-action="minus"
                data-id={item.id}
              >
                −
              </button>
              <span class="text-[0.85rem] font-bold min-w-[20px] text-center text-bone transition-transform duration-200" id={`qty-${item.id}`}>0</span>
              <button
                class="w-7 h-7 rounded-full bg-card border border-border-dim text-bone text-sm flex items-center justify-center transition-all duration-200 hover:border-red hover:text-red hover:bg-red/10 active:scale-90"
                data-action="plus"
                data-cat={cat}
                data-id={item.id}
                data-name={item.name}
                data-price={item.price}
              >
                +
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>