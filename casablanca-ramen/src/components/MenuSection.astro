---
interface Item {
  id: string;
  name: string;
  price: number;
  note?: string;
}
interface Props {
  id: string;
  tag: string;
  title: string;
  cat: string;
  items: Item[];
}
const { id, tag, title, cat, items } = Astro.props;
---
<section class="mb-14 scroll-mt-[130px]" id={`sec-${id}`}>
  <div class="relative flex items-center gap-4 mb-6 pb-3 border-b border-border-dim before:content-[''] before:absolute before:-bottom-px before:left-0 before:w-10 before:h-px before:bg-red">
    <span class="text-[0.6rem] font-bold tracking-[0.25em] uppercase text-red bg-red/10 border border-red/20 px-[0.6rem] py-[0.2rem] rounded-[3px] flex-shrink-0">{tag}</span>
    <h2 class="font-display text-[1.05rem] text-bone tracking-[0.08em]">{title}</h2>
    <div class="flex-1 h-px bg-border-dim"></div>
  </div>
  <div class="grid gap-3 [grid-template-columns:repeat(auto-fill,minmax(160px,1fr))]">
    {
      items.map((item) => (
        <div class="bg-card border border-border-dim rounded-lg p-[0.9rem] flex flex-col gap-[0.35rem] transition-all duration-150 hover:border-red/40 hover:bg-card-hover">
          <span class="text-[0.82rem] font-medium text-bone leading-[1.3]">{item.name}</span>
          {item.note && <span class="text-[0.68rem] text-muted">{item.note}</span>}
          <span class="font-display text-[0.95rem] text-red mt-auto">${item.price}</span>
          <div class="flex items-center justify-between mt-2">
            <span class="text-[0.7rem] text-muted">Cantidad</span>
            <div class="flex items-center gap-[0.4rem]">
              <button
                class="w-6 h-6 rounded-full bg-card border border-border-dim text-bone text-sm leading-none flex items-center justify-center transition-all duration-150 hover:border-red hover:text-red"
                data-action="minus"
                data-id={item.id}
              >
                −
              </button>
              <span class="text-[0.82rem] min-w-[16px] text-center" id={`qty-${item.id}`}>0</span>
              <button
                class="w-6 h-6 rounded-full bg-card border border-border-dim text-bone text-sm leading-none flex items-center justify-center transition-all duration-150 hover:border-red hover:text-red"
                data-action="plus"
                data-cat={cat}
                data-id={item.id}
                data-name={item.name}
                data-price={item.price}
              >
                +
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>