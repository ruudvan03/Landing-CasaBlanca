---
---
<aside class="hidden md:flex flex-col w-[360px] flex-shrink-0 p-6 sticky top-[73px] h-[calc(100vh-73px)] overflow-hidden border-l border-white/5 bg-surface/30 backdrop-blur-md">
  <div class="flex items-center gap-3 mb-6">
    <div class="w-8 h-8 rounded-full bg-red/10 flex items-center justify-center border border-red/20">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
    </div>
    <h3 class="font-display text-[1.1rem] text-bone tracking-[0.08em] uppercase">Tu Pedido</h3>
  </div>

  <div id="sidebar-order-content" class="flex-1 overflow-y-auto pr-2 [scrollbar-width:thin]">
    <div class="flex flex-col items-center justify-center h-full text-center opacity-70">
      <div class="w-20 h-20 mb-4 rounded-full bg-card border border-border-dim flex items-center justify-center relative overflow-hidden shadow-[0_0_15px_rgba(204,26,26,0.15)]">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-12 h-12 filter drop-shadow-[0_0_6px_rgba(204,26,26,0.4)]">
          <path d="M15 48 C 15 78, 85 78, 85 48 Z" fill="url(#sidebarBowlGrad)" stroke="#cc1a1a" stroke-width="3"/>
          <ellipse cx="50" cy="48" rx="35" ry="9" fill="#1a1a1a" stroke="#cc1a1a" stroke-width="3"/>
          <path d="M30 46 Q 40 39, 50 46 Q 60 39, 70 46" fill="none" stroke="#f4ede2" stroke-width="4" stroke-linecap="round"/>
          <path d="M35 43 Q 42 36, 50 43 Q 58 36, 65 43" fill="none" stroke="#eab308" stroke-width="3" stroke-linecap="round"/>
          <circle cx="50" cy="45" r="6" fill="#f4ede2" stroke="#cc1a1a" stroke-width="1.5"/>
          <g class="animate-lid motion-reduce:animate-none">
            <ellipse cx="50" cy="22" rx="36" ry="7" fill="#2a0808" stroke="#cc1a1a" stroke-width="2.5"/>
            <path d="M44 15 L56 15 L53 10 L47 10 Z" fill="#cc1a1a"/>
          </g>
          <defs>
            <linearGradient id="sidebarBowlGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#2a0808" />
              <stop offset="100%" stop-color="#120202" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <p class="text-muted text-[0.85rem] leading-relaxed">
        Tu pedido está vacío.<br />Selecciona tus favoritos para comenzar.
      </p>
    </div>
  </div>

  <div id="sidebar-total" class="hidden mt-4 pt-4 border-t border-white/10 bg-surface">
    <div class="flex justify-between items-end pb-5 font-display">
      <span class="text-muted text-[0.9rem] uppercase tracking-widest">Total Estimado</span>
      <span class="text-red text-[1.6rem] leading-none drop-shadow-[0_0_10px_rgba(204,26,26,0.3)] transition-transform duration-200" id="sidebar-total-price">$0</span>
    </div>
    <div class="flex flex-col gap-3">
      <button
        class="w-full py-3.5 rounded-xl bg-gradient-to-r from-[#8b0000] to-[#cc1a1a] text-white border-0 font-bold text-[0.95rem] tracking-[0.08em] uppercase shadow-[0_5px_15px_rgba(204,26,26,0.3)] transition-all duration-200 hover:shadow-[0_8px_25px_rgba(204,26,26,0.5)] hover:-translate-y-px active:scale-[0.98]"
        id="confirm-btn"
      >
        Confirmar Pedido
      </button>
      <button
        class="w-full py-2.5 rounded-xl bg-transparent text-muted/80 border border-white/10 font-medium text-[0.8rem] transition-all duration-200 hover:text-white hover:bg-white/5 active:scale-[0.98]"
        id="clear-btn"
      >
        Limpiar pedido
      </button>
    </div>
  </div>
</aside>

<style>
  @keyframes liftLid {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(-6deg); }
  }
  .animate-lid { transform-origin: 20px 22px; animation: liftLid 2.5s ease-in-out infinite; }
</style>