---
// src/components/OrderSidebar.astro
---

<aside 
  id="sidebar-container"
  class="fixed inset-x-0 bottom-0 z-50 h-[85vh] max-h-[680px] rounded-t-3xl border-t border-white/10 bg-surface/95 backdrop-blur-2xl shadow-[0_-10px_40px_rgba(0,0,0,0.9)] transform translate-y-full pointer-events-none transition-transform duration-300 ease-out md:translate-y-0 md:pointer-events-auto md:static md:z-20 md:w-[360px] lg:w-[380px] md:h-[calc(100vh-73px)] md:max-h-none md:rounded-none md:border-t-0 md:border-l md:bg-surface/40 md:shadow-2xl flex flex-col p-4 sm:p-5 lg:p-6 overflow-hidden md:sticky md:top-[73px]"
>
  <!-- Handle Superior (Móvil) -->
  <div class="md:hidden w-12 h-1.5 bg-white/20 rounded-full mx-auto mb-3 flex-shrink-0"></div>

  <!-- Header -->
  <div class="flex items-center justify-between gap-3 mb-3 pb-3 border-b border-white/10 flex-shrink-0">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-red/10 flex items-center justify-center border border-red/30 shadow-[0_0_12px_rgba(204,26,26,0.2)] flex-shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-red" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
      </div>
      <div>
        <h3 class="font-display text-[1.05rem] text-bone tracking-[0.08em] uppercase font-bold leading-none">Tu Pedido</h3>
        <span class="text-[0.7rem] text-muted tracking-wider uppercase mt-1 block">Resumen detallado</span>
      </div>
    </div>

    <button 
      type="button" 
      id="close-mobile-cart-btn"
      class="md:hidden w-8 h-8 rounded-full bg-card border border-border-dim flex items-center justify-center text-muted hover:text-white transition-colors active:scale-90 cursor-pointer"
      aria-label="Cerrar pedido"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>
  </div>

  <!-- Contenido Dinámico del Carrito (Scroll Habilitado) -->
  <div
    id="sidebar-order-content"
    class="flex-1 overflow-y-auto overscroll-contain touch-pan-y pr-1.5 custom-scrollbar space-y-3 min-h-0"
  >
    <div id="sb-empty-state" class="flex flex-col items-center justify-center h-full text-center py-8">
      <div class="w-20 h-20 mb-4 rounded-2xl bg-card/80 border border-border-dim flex items-center justify-center relative overflow-hidden shadow-[0_0_20px_rgba(204,26,26,0.15)] group">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" class="w-12 h-12 filter drop-shadow-[0_0_8px_rgba(204,26,26,0.4)] transition-transform duration-300 group-hover:scale-105">
          <path d="M15 48 C 15 78, 85 78, 85 48 Z" fill="url(#sidebarBowlGrad)" stroke="#cc1a1a" stroke-width="3"/>
          <ellipse cx="50" cy="48" rx="35" ry="9" fill="#1a1a1a" stroke="#cc1a1a" stroke-width="3"/>
          <path d="M30 46 Q 40 39, 50 46 Q 60 39, 70 46" fill="none" stroke="#f4ede2" stroke-width="4" stroke-linecap="round"/>
          <path d="M35 43 Q 42 36, 50 43 Q 58 36, 65 43" fill="none" stroke="#eab308" stroke-width="3" stroke-linecap="round"/>
          <circle cx="50" cy="45" r="6" fill="#f4ede2" stroke="#cc1a1a" stroke-width="1.5"/>
          <g class="animate-lid motion-reduce:animate-none">
            <ellipse cx="50" cy="22" rx="36" ry="7" fill="#2a0808" stroke="#cc1a1a" stroke-width="2.5"/>
            <path d="M44 15 L56 15 L53 10 L47 10 Z" fill="#cc1a1a"/>
          </g>
          <defs>
            <linearGradient id="sidebarBowlGrad" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#2a0808" />
              <stop offset="100%" stop-color="#120202" />
            </linearGradient>
          </defs>
        </svg>
      </div>
      <p class="text-muted text-[0.85rem] leading-relaxed max-w-[200px]">
        Tu pedido está vacío.<br />Selecciona tus favoritos para comenzar.
      </p>
    </div>
  </div>

  <!-- Total Estimado y Botones -->
  <div id="sidebar-total" class="hidden mt-auto pt-3 border-t border-white/10 bg-surface/80 backdrop-blur-md flex-shrink-0">
    <div class="flex justify-between items-end pb-3 font-display">
      <div>
        <span class="text-muted text-[0.75rem] uppercase tracking-widest block font-medium">Total Estimado</span>
        <span class="text-[0.68rem] text-muted/70">Impuestos incluidos</span>
      </div>
      <span class="text-red text-[1.55rem] font-bold leading-none drop-shadow-[0_0_12px_rgba(204,26,26,0.4)]" id="sidebar-total-price">$0</span>
    </div>
    <div class="flex flex-col gap-2">
      <button
        type="button"
        class="w-full py-3 rounded-xl bg-gradient-to-r from-[#8b0000] via-[#ab1111] to-[#cc1a1a] text-white border border-red/40 font-bold text-[0.88rem] tracking-[0.08em] uppercase shadow-[0_4px_20px_rgba(204,26,26,0.35)] transition-all duration-200 hover:shadow-[0_6px_28px_rgba(204,26,26,0.55)] active:scale-[0.98] cursor-pointer flex items-center justify-center gap-2"
        id="confirm-btn"
      >
        <span>Confirmar Pedido</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
      <button
        type="button"
        class="w-full py-2 rounded-xl bg-card/40 text-muted/80 border border-white/10 font-medium text-[0.78rem] transition-all duration-200 hover:text-white hover:bg-white/10 active:scale-[0.98] cursor-pointer"
        id="clear-btn"
      >
        Limpiar pedido
      </button>
    </div>
  </div>
</aside>

<style>
  @keyframes liftLid {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(-6deg); }
  }
  .animate-lid { 
    transform-origin: 50px 22px; 
    animation: liftLid 2.5s ease-in-out infinite; 
  }
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: rgba(204, 26, 26, 0.6) transparent;
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 5px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(204, 26, 26, 0.6);
    border-radius: 9999px;
  }
</style>