---
<header class="sticky top-0 z-[100] bg-surface/80 backdrop-blur-xl border-b border-white/10 flex items-center justify-start px-6 py-3 gap-4 shadow-sm transition-all duration-300 relative">
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-red/40 to-transparent"></div>
  <div class="flex items-center gap-3 group cursor-pointer">
    <div class="relative">
      <div class="absolute inset-0 rounded-full bg-red/30 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <img src="/logo.jpg" alt="Logo Casablanca" class="relative w-12 h-12 rounded-full object-cover border-2 border-red shadow-[0_0_10px_rgba(204,26,26,0.3)] transition-transform duration-300 group-hover:scale-105 group-hover:rotate-6" />
    </div>
    <div class="font-logo text-[1.2rem] text-red tracking-[0.04em] leading-[1.1] drop-shadow-[0_0_5px_rgba(204,26,26,0.4)] transition-all duration-300 group-hover:drop-shadow-[0_0_10px_rgba(204,26,26,0.8)]">
      Casablanca
      <span class="block font-logo text-[0.7rem] text-bone tracking-[0.1em] opacity-90 uppercase mt-[2px]">Ramen House</span>
    </div>
  </div>
</header>